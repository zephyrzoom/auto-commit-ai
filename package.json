{
  "name": "git-sync-tool",
  "version": "1.0.0",
  "description": "Git 同步工具 - 自动同步提交记录并重写作者信息",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.autcommit.gitsync",
    "productName": "Git 同步工具",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["arm64"]
        }
      ]
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-cron": "^3.0.3",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  }
}
